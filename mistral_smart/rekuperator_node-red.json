    {
        "id": "a13f75c47fb36020",
        "type": "function",
        "z": "db420a629b019bad",
        "name": "parse JSON",
        "func": "if (!msg.payload) return null;\n\nif (msg.payload.Status) {\n    if (msg.payload.Status === \"OK\") {\n        return [null, { trigger: true }];\n    } else {\n        node.error(\"Błąd statusu: \" + msg.payload.Status, msg);\n        return null;\n    }\n} else if (msg.payload.all) {\n    let dataRaw = msg.payload.all;\n    let parsed;\n\n    try {\n        parsed = typeof dataRaw === 'object' ? dataRaw : JSON.parse(dataRaw);\n    } catch (err) {\n        node.error(\"Nieprawidłowy JSON w msg.payload.all: \" + err.message, msg);\n        return null;\n    }\n\n    return [\n        { payload: parsed.tmp, source: \"device\" },\n        { payload: parsed.dat, source: \"device\" },\n        { payload: parsed.stn, source: \"device\" },\n        { payload: parsed.sez, source: \"device\" },\n        { payload: parsed.flt, source: \"device\" },\n        { payload: parsed.asc, source: \"device\" },\n        { payload: parsed.bps, source: \"device\" },\n        { payload: parsed.iaw, source: \"device\" },\n        { payload: parsed.spd, source: \"device\" }\n    ];\n} \nreturn null;",
        "outputs": 9,
        "timeout": 0,
        "noerr": 0,
