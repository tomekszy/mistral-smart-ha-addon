    {
        "id": "c5fa8a711b977a55",
        "type": "function",
        "z": "db420a629b019bad",
        "name": "parse temp",
        "func": "const tmp = msg.payload || \"\";\nconst lines = tmp.split(\";\");\n\nconst parseVal = val => {\n    let v = val.trim();\n    if (v === \"---\") return null;\n    let num = parseFloat(v);\n    // Filtrowanie domyślnych wartości rozwarcia wejść analogowych (+50.0, +63.0)\n    if (isNaN(num) || num === 50.0 || num === 63.0) return null;\n    return num;\n};\n\nconst parsed = lines.map(line => line.split(\",\").map(parseVal));\n\n// Zbieramy aktywne wartości temperatur z poszczególnych linii:\n// Linia 1: T1 Czerpnia (np. +15.5)\n// Linia 2: T2 Wyrzutnia (+16.0), T3 Pokój (+17.0)\nconst t1_val = parsed[0]?.find(v => v !== null) ?? null;\nconst t2_val = parsed[1]?.[0] ?? null;\nconst t3_val = parsed[1]?.[1] ?? null;\n\nreturn [\n    { payload: t1_val, attributes: { raw_line_1: lines[0] }, source: msg.source },\n    { payload: t2_val, attributes: { raw_line_2: lines[1] }, source: msg.source },\n    { payload: t3_val, attributes: { raw_line_3: lines[2] }, source: msg.source }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
