        "id": "ce791323aa685745",
        "type": "function",
        "z": "db420a629b019bad",
        "name": "distinctUntilChanges",
        "func": "let payload = msg.payload || \"\";\n\nif (!payload.startsWith(\"data=\")) {\n    return msg;\n}\n\nlet key = payload.slice(5, 10);\nlet prev = flow.get('last_written_' + key) || null;\n\nif (msg.source === \"user\") {\n    if (payload !== prev) {\n        flow.set('last_written_' + key, payload);\n        return msg; // Przepuszcza tylko raz poprawny zapis od użytkownika\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
