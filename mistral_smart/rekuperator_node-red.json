    {
        "id": "776ef0b93349aab0",
        "type": "function",
        "z": "db420a629b019bad",
        "name": "parse date",
        "func": "const dat = msg.payload || \"\"; // np. \"01654\"\nif (dat.length < 5) return null;\n\nconst daysNames = [\"poniedziałek\", \"wtorek\", \"środa\", \"czwartek\", \"piątek\", \"sobota\", \"niedziela\"];\n\nlet day_raw = parseInt(dat[0]) || 0;\nlet hour = dat.substring(1, 3);\nlet minute = dat.substring(3, 5);\n\n// Tworzenie poprawnego timestampu ISO-8601 ze strefą czasową\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\n\n// Określenie przesunięcia strefy czasowej (np. +02:00 / +01:00)\nconst tzOffsetMinutes = -now.getTimezoneOffset();\nconst offsetSign = tzOffsetMinutes >= 0 ? '+' : '-';\nconst offsetHours = String(Math.floor(Math.abs(tzOffsetMinutes) / 60)).padStart(2, '0');\nconst offsetMins = String(Math.abs(tzOffsetMinutes) % 60).padStart(2, '0');\nconst tzString = `${offsetSign}${offsetHours}:${offsetMins}`;\n\n// Pełny ciąg ISO gotowy do sparsowania przez klasę timestamp w HA\nconst isoTimestamp = `${year}-${month}-${day}T${hour}:${minute}:00${tzString}`;\n\nreturn {\n    payload: isoTimestamp,\n    attributes: {\n        day_of_week: day_raw,\n        day_name: daysNames[day_raw] || \"nieznany\",\n        formatted_time: `${hour}:${minute}`\n    },\n    source: msg.source\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 120,
        "wires": [
