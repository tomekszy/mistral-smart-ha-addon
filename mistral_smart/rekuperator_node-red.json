    {
        "id": "9a8baa4d2fd06e75",
        "type": "function",
        "z": "db420a629b019bad",
        "name": "parse speed",
        "func": "const spd = msg.payload || \"\";\n\nconst fan_speed = parseInt(spd[0]) || 0;\nconst mode = spd[1] === \"a\" ? \"wg programu dobowego\" : \"ręczny\";\nconst direction_map = { o: \"nawiew + wywiew\", i: \"tylko nawiew\", w: \"tylko wywiew (otwarte okno)\" };\nconst direction = direction_map[spd[2]] || \"nawiew + wywiew\";\nconst airing_on = spd.slice(3).length >= 3;\nconst airing_off = spd.slice(3).length < 3;\nconst vent_time = airing_off ? parseInt(spd.slice(3)) || 0 : parseInt(spd.slice(5)) || 0;\n\nreturn [\n    { payload: fan_speed, source: msg.source },\n    { payload: mode, source: msg.source },\n    { payload: direction, source: msg.source },\n    { payload: vent_time, source: msg.source },\n    airing_on ? { payload: true, source: msg.source } : null,\n    airing_off ? { payload: false, source: msg.source } : null\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 460,
        "wires": [
