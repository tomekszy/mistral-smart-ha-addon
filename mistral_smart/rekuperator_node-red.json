        "func": "const map = {\n    \"nawiew + wywiew\": \"po\",\n    \"tylko wywiew (otwarte okno)\": \"pw\",\n    \"tylko nawiew\": \"pi\"\n};\nconst normalize = s => (s ?? \"\").trim().toLowerCase();\nlet input = normalize(msg.payload);\nlet found = false;\nfor (let key in map) {\n    if (normalize(key) === input) {\n        msg.payload = \"data=spd:\" + map[key];\n        found = true;\n        break;\n    }\n}\nif (!found) {\n    msg.payload = \"data=spd:\" + map[\"nawiew + wywiew\"];\n}\nmsg.source = \"user\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 380,
